ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY_HERE

# Newsletter ingestion (watchtower_engine.py, port 5001).
# NEWSLETTER_PDF_DIR: the folder where you print/save newsletter PDFs. Required
#   for /list_pending_newsletters and /import_newsletter. PDFs never move.
# NEWSLETTER_EXTRACTED_DIR: optional; defaults to <NEWSLETTER_PDF_DIR>/extracted/.
#   Holds one <stem>.json per imported issue (the "already imported" marker) plus
#   the rolling _store.json (live / archive / discarded).
# NEWSLETTER_START_DATE: optional (YYYY-MM-DD). Issues dated/mtime'd before this
#   are grayed out in the Import picker AND rejected server-side. Use this to
#   start the live-set store from an arbitrary week instead of your full archive
#   — importing an issue OLDER than ones already in the store corrupts the store
#   (its silence-abandons logic gets applied against trades that didn't exist yet
#   as of its date), so this is a hard floor, not just a display hint. Unset to
#   allow every pending PDF.
NEWSLETTER_PDF_DIR=C:\path\to\your\newsletter\pdfs
# NEWSLETTER_EXTRACTED_DIR=
# NEWSLETTER_START_DATE=
